VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY

# Clave pública VAPID (prefijo VITE_ para que esté disponible en el frontend).
# Generar con: node_modules/.bin/web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=TU-CLAVE-PUBLICA-VAPID

# Las tres siguientes van SOLO en las variables de entorno de Vercel (no en el repo):
# VAPID_PUBLIC_KEY=TU-CLAVE-PUBLICA-VAPID
# VAPID_PRIVATE_KEY=TU-CLAVE-PRIVADA-VAPID
# VAPID_EMAIL=tu-correo@dominio.com
# SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY
